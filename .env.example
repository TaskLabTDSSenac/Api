# Opcional: sem DATABASE_URL, tasklab.db é criado na raiz do projeto,
# independentemente da pasta de onde o Python foi executado.
# Copie este arquivo para .env e substitua o placeholder JWT abaixo.
# Variáveis de ambiente têm prioridade sobre o arquivo .env.
# Exemplo de caminho absoluto no Windows (a pasta deve existir):
# DATABASE_URL=sqlite:///C:/dados/tasklab.db

# OBRIGATÓRIO: placeholder inválido, substitua por um segredo gerado localmente.
# Gere com: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=SUBSTITUA_PELA_CHAVE_GERADA_NAO_USE_ESTE_PLACEHOLDER
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
